{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "railway": {
        "type": "local",
        "command": ["npx", "-y", "@railway/mcp-server"],
      },
    },
  },
}
